# --- Database (SQLite by default; PostgreSQL in docker-compose) ---
DATABASE_URL=sqlite:///./data/insightforge.db
# DATABASE_URL=postgresql+psycopg2://insight:insight@localhost:5432/insightforge

# --- LLM: none | anthropic | openai  (none = offline heuristic engine, no API key needed) ---
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- RAG ---
CHROMA_PATH=./data/chroma
EMBEDDING_PROVIDER=hashing   # hashing (offline) | openai
MAX_RESULT_ROWS=1000
